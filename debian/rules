#!/usr/bin/make -f
include /usr/share/dpkg/pkg-info.mk
WITH_UI := $(if $(filter pkg.librustyaxe.noui,$(DEB_BUILD_PROFILES)),false,true)
WITH_CURSES := $(if $(filter pkg.librustyaxe.nocurses,$(DEB_BUILD_PROFILES)),false,true)
%:
	dh $@

override_dh_auto_build:
	$(MAKE) all VERSION=$(DEB_VERSION_UPSTREAM) WITH_MONGOOSE=false WITH_UI=$(WITH_UI) WITH_CURSES=$(WITH_CURSES)

override_dh_auto_install:
	$(MAKE) install VERSION=$(DEB_VERSION_UPSTREAM) DESTDIR=$(CURDIR)/debian/tmp WITH_UI=$(WITH_UI) WITH_CURSES=$(WITH_CURSES)

override_dh_auto_clean:
	$(MAKE) distclean
